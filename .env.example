DATABASE_URL="postgresql://app_user:replace-with-a-strong-password@localhost:5432/app?schema=public"
POSTGRES_DB="app"
POSTGRES_USER="app_user"
POSTGRES_PASSWORD="replace-with-a-strong-password"
APP_BASE_URL="http://localhost:3000"
TRUSTED_ORIGINS=""
SESSION_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_SECURE="true"
ROOT_ADMIN_EMAILS="admin@example.com"
# 后台敏感配置加密密钥：必须是 32 字节以上随机字符串。
# 用于加密后台保存的支付宝应用私钥；真实支付宝私钥不再强制写入 .env。
# 未配置时禁止保存应用私钥。
SETTINGS_ENCRYPTION_KEY=""
# Deprecated fallback key; code still兼容读取，但新部署请改用 ROOT_ADMIN_EMAILS
# ADMIN_EMAILS="admin@example.com"
MAIL_MAILER="smtp"
MAIL_SCHEME="smtps"
MAIL_HOST="smtp.qq.com"
MAIL_PORT="465"
MAIL_USERNAME="your-account@qq.com"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM_ADDRESS="your-account@qq.com"
MAIL_FROM_NAME="Tomato App"

# AI idea generation (OpenAI-compatible proxy)
AI_PROVIDER_LABEL="主线路"
AI_BASE_URL="https://api.99dun.cc"
AI_API_KEY="replace-with-your-ai-key"
AI_MODEL="gpt-5.4"
AI_MODEL_OPTIONS="gpt-5.4,gpt-5.2,gpt-5.4-mini"
AI_DAILY_CALL_LIMIT="100"
AI_DAILY_TOKEN_LIMIT="300000"
AI_MINUTE_CALL_LIMIT="3"
AI_REQUEST_TIMEOUT_MS="240000"
AI_STREAM_IDLE_TIMEOUT_MS="300000"
AI_FAST_FAIL_TIMEOUT_MS="45000"
AI_PROVIDER_CIRCUIT_FAILURES="3"
AI_PROVIDER_CIRCUIT_COOLDOWN_MS="120000"

# Backup AI (Volcengine Ark / Doubao, OpenAI-compatible)
ARK_PROVIDER_LABEL="豆包"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_API_KEY="replace-with-your-ark-api-key"
ARK_MODEL="doubao-seed-2-0-pro-260215"
ARK_MODEL_OPTIONS="doubao-seed-2-0-pro-260215"

# Anthropic-compatible Messages API
ANTHROPIC_PROVIDER_LABEL="Anthropic"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_KEY="replace-with-your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_MODEL_OPTIONS="claude-sonnet-4-20250514,claude-opus-4-1-20250805"
ANTHROPIC_VERSION="2023-06-01"
